# PostgreSQL connection string (Supabase, Neon, Railway, or local PostgreSQL)
# Example (Neon): postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example (Supabase pooler): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Gmail SMTP settings for instant inquiry email notifications
# Generate a 16-character App Password in Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER="eliashabib2024@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"

# Recipient email for inquiry notifications (defaults to eliashabib2024@gmail.com)
INQUIRY_NOTIFY_EMAIL="eliashabib2024@gmail.com"
