generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  eventDate String
  details   String
  sourceUrl String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventDate])
}
